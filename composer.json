{
    "name": "averroes/cms",
    "description": "Dynamic PHP & MySQL CMS for Averroes International School",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "Full Stack Developer",
            "role": "Lead Architect"
        }
    ],
    "require": {
        "php": ">=7.4.0 || ^8.0 || ^8.1 || ^8.2 || ^8.3",
        "ext-pdo": "*",
        "ext-fileinfo": "*",
        "ext-session": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "includes/functions.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}

# Averroes International School CMS - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.

APP_NAME="Averroes International School"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/averroes

# Database Configuration (Default XAMPP credentials)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=averroes_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Session Configuration
SESSION_LIFETIME=0
